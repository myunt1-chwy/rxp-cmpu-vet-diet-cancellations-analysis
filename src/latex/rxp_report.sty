\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{rxp_report}[2026/10/13 Reusable analysis report formatting]

% Use the article class with its 10pt option for the default text size.
\RequirePackage[default,lf]{carlito}
\RequirePackage{xcolor}
\RequirePackage{titlesec}
\RequirePackage{geometry}
\RequirePackage{longtable}
\RequirePackage{graphicx}
\RequirePackage[hypcap=false]{caption}
\RequirePackage{etoolbox}
\RequirePackage{enumitem}
\RequirePackage{needspace}
\RequirePackage{lscape}
\RequirePackage[left]{lineno}

\geometry{left=0.7in,right=0.6in,top=0.55in,bottom=0.55in}
\definecolor{reportnavy}{HTML}{003366}
\titleformat*{\section}{\Large\bfseries\color{reportnavy}}
\titleformat*{\subsection}{\large\bfseries\color{reportnavy}}
\titleformat*{\subsubsection}{\normalsize\bfseries\color{reportnavy}}
\titleformat{\paragraph}[block]{\normalsize\bfseries\color{reportnavy}}{\theparagraph}{1em}{}
\titleformat{\subparagraph}[block]{\normalsize\bfseries\color{reportnavy}}{\thesubparagraph}{1em}{}
\titlespacing*{\section}{0pt}{2ex}{1ex}
\titlespacing*{\subsection}{0pt}{1.5ex}{0.5ex}
\titlespacing*{\subsubsection}{0pt}{1ex}{0.35ex}
\titlespacing*{\paragraph}{0pt}{0.75ex}{0.25ex}
\titlespacing*{\subparagraph}{0pt}{0.75ex}{0.25ex}

\setlength{\emergencystretch}{6em}
\setlength{\tabcolsep}{3pt}
\setlength{\parskip}{3pt plus 1pt minus 1pt}
\setlist{topsep=2pt,partopsep=0pt,itemsep=0pt,parsep=0pt}
\setlist[itemize]{leftmargin=1.5em,labelsep=0.4em}
\AtBeginEnvironment{longtable}{\fontsize{8}{10}\selectfont}
\AtBeginDocument{%
  \setlength{\abovedisplayskip}{5pt plus 1pt minus 1pt}%
  \setlength{\belowdisplayskip}{5pt plus 1pt minus 1pt}%
  \setlength{\abovedisplayshortskip}{3pt plus 1pt minus 1pt}%
  \setlength{\belowdisplayshortskip}{3pt plus 1pt minus 1pt}%
  \linenumbers
  \ifcsname pandocbounded\endcsname
    \renewcommand{\pandocbounded}[1]{\fbox{\resizebox{0.5\linewidth}{!}{#1}}}%
  \fi
}
