WITH source AS (
    WITH registry AS (
        SELECT
            rx_id,
            MIN(customer_id) AS customer_id,
            MIN(is_vet_diet_flag) AS is_vet_diet_flag,
            MIN(approval_channel) AS approval_channel,
            MIN(prescription_source) AS prescription_source,
            GREATEST(
                COUNT(DISTINCT customer_id)
                + IFF(COUNT_IF(customer_id IS NULL) > 0, 1, 0),
                COUNT(DISTINCT is_vet_diet_flag)
                + IFF(COUNT_IF(is_vet_diet_flag IS NULL) > 0, 1, 0),
                COUNT(DISTINCT approval_channel)
                + IFF(COUNT_IF(approval_channel IS NULL) > 0, 1, 0),
                COUNT(DISTINCT prescription_source)
                + IFF(COUNT_IF(prescription_source IS NULL) > 0, 1, 0)
            ) AS registry_variants
        FROM edldb.bt_hca_hcdm.rxp_prescriptions
        GROUP BY rx_id
    ),

    aged_keys AS (
        SELECT
            l.order_id,
            l.order_line_id,
            MAX(p.registry_variants) AS registry_variants
        FROM edldb.bt_hca_hcdm.order_line_cost_measures_rxp AS l
        INNER JOIN registry AS p
            ON
                NULLIF(TRIM(l.rx_id), '') = p.rx_id
                AND l.customer_id = p.customer_id
        WHERE
            l.is_vet_diet_flag = TRUE AND p.is_vet_diet_flag = TRUE
            AND p.approval_channel = 'CUSTOMER_UPLOAD'
            AND p.prescription_source = 'CMPU'
            AND LOWER(TRIM(l.order_cancel_reason)) = 'aged order'
            AND l.order_cancel_dttm >= '{{ start_date }}'::TIMESTAMP_NTZ
            AND l.order_cancel_dttm < '{{ end_date }}'::TIMESTAMP_NTZ
        GROUP BY l.order_id, l.order_line_id
    ),

    aged_lines AS (
        SELECT
            l.order_id,
            l.order_line_id,
            l.customer_id,
            l.order_placed_dttm AS placed_at_utc,
            l.order_cancel_dttm AS cancelled_at_utc,
            k.registry_variants
        FROM edldb.bt_hca_hcdm.order_line_cost_measures_rxp AS l
        INNER JOIN
            aged_keys AS k
            ON l.order_id = k.order_id AND l.order_line_id = k.order_line_id
    ),

    aged_orders AS (
        SELECT
            order_id,
            MIN(customer_id) AS customer_id,
            MIN(cancelled_at_utc) AS cancelled_at_utc,
            MAX(registry_variants) AS registry_variants,
            COUNT(DISTINCT order_line_id) AS qualifying_lines,
            COUNT(DISTINCT customer_id)
            + IFF(COUNT_IF(customer_id IS NULL) > 0, 1, 0) AS customer_variants,
            COUNT(DISTINCT cancelled_at_utc)
            + IFF(COUNT_IF(cancelled_at_utc IS NULL) > 0, 1, 0)
                AS cancellation_variants
        FROM aged_lines
        GROUP BY order_id
    )

    SELECT
        a.order_id,
        a.customer_id,
        a.registry_variants,
        a.qualifying_lines,
        a.customer_variants,
        a.cancellation_variants,
        c.order_id AS contact_order_id,
        c.customer_id AS contact_customer_id,
        c.leg_id,
        c.session_id,
        c.session_channel,
        c.session_ingress_point,
        c.session_initial_direction,
        c.handled_flag,
        TO_CHAR(a.cancelled_at_utc, 'YYYY-MM-DD HH24:MI:SS.FF9')
            AS cancelled_at_utc,
        TO_CHAR(c.session_start_dttm, 'YYYY-MM-DD HH24:MI:SS.FF9')
            AS contact_at_utc
    FROM aged_orders AS a LEFT JOIN edldb.bt_customer_care.fct_contacts_brd AS c
        ON
            a.order_id = c.order_id
            AND ((
                c.session_start_dttm
                >= DATEADD(DAY, {{ min_day }}, a.cancelled_at_utc)
                AND c.session_start_dttm
                < DATEADD(DAY, {{ end_day }}, a.cancelled_at_utc)
            ) OR c.session_start_dttm IS NULL)
),

days AS (
    SELECT
        ROW_NUMBER() OVER (ORDER BY SEQ4())
        - {{ min_day_offset }} AS relative_day
    FROM TABLE(GENERATOR(rowcount => {{ day_count }}))
),

counts AS (
    SELECT
        FLOOR(
            DATEDIFF(
                NANOSECOND,
                cancelled_at_utc::TIMESTAMP_NTZ,
                contact_at_utc::TIMESTAMP_NTZ
            )::DOUBLE
            / 86400000000000.0
        )::INTEGER AS relative_day,
        COUNT(DISTINCT customer_id) AS distinct_customers,
        COUNT(DISTINCT order_id) AS distinct_aged_orders
    FROM source
    WHERE
        contact_order_id IS NOT NULL AND contact_customer_id = customer_id
        AND LOWER(TRIM(session_initial_direction)) = 'inbound'
        AND contact_at_utc IS NOT NULL
        AND COALESCE(handled_flag, FALSE) IN (
            TRUE{% if not handled_only %}, FALSE{% endif %}
        )
    GROUP BY relative_day
)

SELECT
    d.relative_day,
    COALESCE(c.distinct_customers, 0) AS distinct_customers,
    COALESCE(c.distinct_aged_orders, 0) AS distinct_aged_orders
FROM days AS d
LEFT JOIN counts AS c ON d.relative_day = c.relative_day
ORDER BY d.relative_day
