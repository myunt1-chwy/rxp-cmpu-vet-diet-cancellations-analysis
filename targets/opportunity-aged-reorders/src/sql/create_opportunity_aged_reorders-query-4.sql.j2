-- sqlfluff:dialect:duckdb
SELECT COALESCE(SUM(CAST(reorder_known_net_sales AS DECIMAL(38, 5))), 0)
FROM (
    SELECT DISTINCT
        reorder_order_id,
        reorder_line_id,
        reorder_known_net_sales
    FROM matches
    WHERE
        qualifying_non_cancelled
        AND reorder_shipped_utc IS NOT NULL AND (
            {% if study == "same-part-pet" %}
                original_pet_id = reorder_pet_id
                AND original_product_part_number = reorder_product_part_number
                AND NULLIF(TRIM(original_product_part_number), '') IS NOT NULL
                AND NULLIF(TRIM(reorder_product_part_number), '') IS NOT NULL
            {% elif study == "same-pet-different-part" %}
                original_pet_id = reorder_pet_id
                AND original_product_part_number <> reorder_product_part_number
                AND reorder_is_vet_diet = TRUE
                AND NULLIF(TRIM(original_product_part_number), '') IS NOT NULL
                AND NULLIF(TRIM(reorder_product_part_number), '') IS NOT NULL
            {% elif study == "any-vet-diet" %}
                reorder_is_vet_diet = TRUE
            {% elif study == "any-chewy" %}
                TRUE
            {% endif %}
        )
)
