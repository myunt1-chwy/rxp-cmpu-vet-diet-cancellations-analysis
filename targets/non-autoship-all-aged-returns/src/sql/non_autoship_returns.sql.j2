-- Adapted from playground/opportunity_aged_reorders_with_autoship.sql.
-- Original flags never restrict cohort membership; later line FALSE only.
WITH registry AS (
    SELECT
        rx_id,
        MIN(customer_id) AS customer_id,
        MIN(is_vet_diet_flag) AS is_vet_diet_flag,
        MIN(approval_channel) AS approval_channel,
        MIN(prescription_source) AS prescription_source,
        GREATEST(
            COUNT(DISTINCT customer_id)
            + IFF(COUNT_IF(customer_id IS NULL) > 0, 1, 0),
            COUNT(DISTINCT is_vet_diet_flag)
            + IFF(COUNT_IF(is_vet_diet_flag IS NULL) > 0, 1, 0),
            COUNT(DISTINCT approval_channel)
            + IFF(COUNT_IF(approval_channel IS NULL) > 0, 1, 0),
            COUNT(DISTINCT prescription_source)
            + IFF(COUNT_IF(prescription_source IS NULL) > 0, 1, 0)
        ) AS registry_variants
    FROM edldb.bt_hca_hcdm.rxp_prescriptions
    GROUP BY rx_id
),

aged_keys AS (
    SELECT
        l.order_id,
        l.order_line_id,
        MAX(p.registry_variants) AS registry_variants
    FROM edldb.bt_hca_hcdm.order_line_cost_measures_rxp AS l
    INNER JOIN registry AS p
        ON NULLIF(TRIM(l.rx_id), '') = p.rx_id AND l.customer_id = p.customer_id
    WHERE
        l.is_vet_diet_flag = TRUE AND p.is_vet_diet_flag = TRUE
        AND p.approval_channel = 'CUSTOMER_UPLOAD'
        AND p.prescription_source = 'CMPU'
        AND LOWER(TRIM(l.order_cancel_reason)) = 'aged order'
        AND l.order_cancel_dttm >= '{{ start_date }}'::TIMESTAMP_NTZ
        AND l.order_cancel_dttm < '{{ end_date }}'::TIMESTAMP_NTZ
    GROUP BY l.order_id, l.order_line_id
),

originals AS (
    SELECT
        l.order_id AS original_order_id,
        l.order_line_id AS original_line_id,
        MAX(k.registry_variants) AS registry_variants,
        MIN(l.customer_id) AS original_customer_id,
        MIN(l.pet_id) AS original_pet_id,
        MIN(l.product_part_number) AS original_product_part_number,
        MIN(l.order_cancel_dttm) AS original_cancel_utc,
        MIN(LOWER(TRIM(l.order_cancel_reason))) AS original_reason,
        COUNT(DISTINCT l.customer_id)
        + IFF(COUNT_IF(l.customer_id IS NULL) > 0, 1, 0) AS customer_variants,
        COUNT(DISTINCT l.pet_id)
        + IFF(COUNT_IF(l.pet_id IS NULL) > 0, 1, 0) AS pet_variants,
        COUNT(DISTINCT l.product_part_number)
        + IFF(COUNT_IF(l.product_part_number IS NULL) > 0, 1, 0)
            AS part_variants,
        COUNT(DISTINCT l.order_cancel_dttm)
        + IFF(COUNT_IF(l.order_cancel_dttm IS NULL) > 0, 1, 0)
            AS cancel_variants,
        COUNT(DISTINCT LOWER(TRIM(l.order_cancel_reason)))
        + IFF(COUNT_IF(l.order_cancel_reason IS NULL) > 0, 1, 0)
            AS reason_variants
    FROM edldb.bt_hca_hcdm.order_line_cost_measures_rxp AS l
    INNER JOIN
        aged_keys AS k
        ON l.order_id = k.order_id AND l.order_line_id = k.order_line_id
    GROUP BY l.order_id, l.order_line_id
),

candidate_keys AS (
    SELECT DISTINCT
        l.order_id,
        l.order_line_id
    FROM edldb.bt_hca_hcdm.order_line_cost_measures_rxp AS l
    INNER JOIN originals AS a
        ON
            l.customer_id = a.original_customer_id

            AND l.pet_id = a.original_pet_id
            AND l.product_part_number = a.original_product_part_number

            AND l.order_id <> a.original_order_id
            AND l.order_placed_dttm > a.original_cancel_utc
            AND l.order_placed_dttm
            <= DATEADD(DAY, {{ followup_days }}, a.original_cancel_utc)
            AND l.order_placed_dttm <= '{{ as_of_date }}'::TIMESTAMP_NTZ
),

transaction_keys AS (
    SELECT order_line_id FROM aged_keys
    UNION DISTINCT
    SELECT order_line_id FROM candidate_keys
),

subscription_transactions AS (
    -- Reduce transaction rows before joining shipment-level financial records.
    -- Missing membership means non-autoship; a present NULL flag stays unknown.
    SELECT
        t.order_line_id,
        COUNT(*) AS transaction_records,
        -- This column is TIMESTAMP_LTZ, not a timezone-free Eastern clock.
        -- Normalize its stored instant before removing timezone metadata.
        -- Do not cast to NTZ first: that would use session-local wall time.
        MIN(CONVERT_TIMEZONE('UTC', t.order_line_shipped_dttm)::TIMESTAMP_NTZ)
            AS transaction_shipped_utc,
        MIN(t.subscription_group_key) AS subscription_group_key,
        MIN(t.subscription_key) AS subscription_key,
        MIN(t.order_key) AS order_key,
        MIN(t.product_key) AS product_key,
        MIN(t.one_time_shipped_flag) AS one_time_shipped_flag,
        MIN(t.auto_added_flag) AS auto_added_flag,
        MIN(t.order_line_pbfresh_subscription_flag)
            AS order_line_pbfresh_subscription_flag,
        MIN(t.order_line_auto_reorder_flag) AS order_line_auto_reorder_flag,
        GREATEST(
            COUNT(DISTINCT COALESCE(t.subscription_group_key::VARCHAR, 'NULL')),
            COUNT(DISTINCT COALESCE(t.subscription_key::VARCHAR, 'NULL')),
            COUNT(DISTINCT COALESCE(t.order_key::VARCHAR, 'NULL')),
            COUNT(DISTINCT COALESCE(t.product_key::VARCHAR, 'NULL')),
            COUNT(DISTINCT COALESCE(t.one_time_shipped_flag::VARCHAR, 'NULL')),
            COUNT(DISTINCT COALESCE(t.auto_added_flag::VARCHAR, 'NULL')),
            COUNT(DISTINCT COALESCE(
                t.order_line_pbfresh_subscription_flag::VARCHAR, 'NULL'
            )),
            COUNT(DISTINCT COALESCE(
                t.order_line_auto_reorder_flag::VARCHAR, 'NULL'
            ))
        ) AS transaction_variants
    FROM edldb.bt_shared_dw.fct_subscription_order_line_transaction AS t
    INNER JOIN transaction_keys AS k ON t.order_line_id = k.order_line_id
    GROUP BY t.order_line_id
),

subscription_product_keys AS (
    -- Only candidate autoship lines can qualify in 3.1.4. Select their pairs
    -- first, then scan ALL history for each pair below. This avoids loading
    -- unrelated histories for non-autoship or original aged lines.
    SELECT DISTINCT
        t.subscription_key,
        t.product_key
    FROM subscription_transactions AS t
    INNER JOIN candidate_keys AS k ON t.order_line_id = k.order_line_id
    WHERE
        t.order_line_auto_reorder_flag = TRUE
        AND t.subscription_key IS NOT NULL AND t.product_key IS NOT NULL
),

subscription_shipped_history AS (
    -- All available shipments for these pairs, including before the study,
    -- other customers/orders, one-time lines and other autoship flags.
    -- No aged-cohort, pet, approval, order-success or study-date restriction
    -- belongs here: any earlier shipped line prevents a later first shipment.
    -- Collapse duplicate rows/split shipments to each physical line's first
    -- shipment. NULL shipment timestamps do not establish a shipped line.
    SELECT
        t.subscription_key,
        t.product_key,
        t.order_line_id,
        MIN(CONVERT_TIMEZONE('UTC', t.order_line_shipped_dttm)::TIMESTAMP_NTZ)
            AS history_line_shipped_utc
    FROM edldb.bt_shared_dw.fct_subscription_order_line_transaction AS t
    INNER JOIN subscription_product_keys AS k
        ON
            t.subscription_key = k.subscription_key
            AND t.product_key = k.product_key
    WHERE t.order_line_shipped_dttm IS NOT NULL
    GROUP BY t.subscription_key, t.product_key, t.order_line_id
),

subscription_product_first_shipments AS (
    -- Product is part of the partition: adding a new product to an existing
    -- subscription can have its own initial shipment.
    -- Timestamp equality intentionally includes ALL lines tied for earliest;
    -- never choose an arbitrary order_line_id via ROW_NUMBER.
    SELECT
        subscription_key,
        product_key,
        MIN(history_line_shipped_utc) AS product_first_shipped_utc
    FROM subscription_shipped_history
    GROUP BY subscription_key, product_key
),

order_cancellations_keys AS (
    SELECT DISTINCT order_id FROM candidate_keys
),

order_cancellations AS (
    -- Inspect every line of candidate orders, including other products.
    SELECT
        l.order_id,
        MAX(IFF(
            l.order_order_line_status = 'X'
            OR NULLIF(TRIM(l.order_cancel_reason), '') IS NOT NULL
            OR l.order_cancel_dttm IS NOT NULL, 1, 0
        )) AS order_has_cancellation,
        MAX(IFF(l.order_order_line_status IS NULL, 1, 0))
            AS order_has_unknown_status
    FROM edldb.bt_hca_hcdm.order_line_cost_measures_rxp AS l
    INNER JOIN
        order_cancellations_keys AS k
        ON l.order_id = k.order_id
    GROUP BY l.order_id
),

financial AS (
    SELECT
        l.order_id,
        l.order_line_id,
        l.shipment_key,
        MIN(l.customer_id) AS customer_id,
        MIN(l.pet_id) AS pet_id,
        MIN(l.product_part_number) AS product_part_number,
        MIN(l.is_vet_diet_flag) AS is_vet_diet_flag,
        MIN(l.order_placed_dttm) AS placed_at_utc,
        MIN(l.order_line_shipped_dttm) AS shipped_at_utc,
        MIN(l.order_line_net_sales) AS net_sales,
        MIN(IFF(
            t.order_line_id IS NULL, FALSE, t.order_line_auto_reorder_flag
        )) AS line_auto_reorder_flag,
        MIN(t.subscription_group_key) AS subscription_group_key,
        MIN(t.subscription_key) AS subscription_key,
        MIN(t.order_key) AS order_key,
        MIN(t.product_key) AS product_key,
        MIN(t.one_time_shipped_flag) AS one_time_shipped_flag,
        MIN(t.auto_added_flag) AS auto_added_flag,
        MIN(t.order_line_pbfresh_subscription_flag)
            AS order_line_pbfresh_subscription_flag,
        MAX(t.transaction_records) AS transaction_records,
        MAX(t.transaction_variants) AS transaction_variants,
        MIN(t.transaction_shipped_utc) AS transaction_shipped_utc,
        MIN(h.product_first_shipped_utc) AS product_first_shipped_utc,
        COUNT(
            DISTINCT COALESCE(t.order_line_auto_reorder_flag::VARCHAR, 'NULL')
        )
            AS line_flag_variants,
        COUNT(DISTINCT COALESCE(l.is_vet_diet_flag::VARCHAR, 'NULL'))
            AS vet_diet_variants,
        COUNT(DISTINCT l.order_line_net_sales)
        + IFF(COUNT_IF(l.order_line_net_sales IS NULL) > 0, 1, 0)
            AS sales_variants,
        COUNT(DISTINCT l.customer_id)
        + IFF(COUNT_IF(l.customer_id IS NULL) > 0, 1, 0) AS customer_variants,
        COUNT(DISTINCT l.pet_id)
        + IFF(COUNT_IF(l.pet_id IS NULL) > 0, 1, 0) AS pet_variants,
        COUNT(DISTINCT l.product_part_number)
        + IFF(COUNT_IF(l.product_part_number IS NULL) > 0, 1, 0)
            AS part_variants,
        COUNT(DISTINCT l.order_placed_dttm)
        + IFF(COUNT_IF(l.order_placed_dttm IS NULL) > 0, 1, 0)
            AS placement_variants
    FROM edldb.bt_hca_hcdm.order_line_cost_measures_rxp AS l
    INNER JOIN candidate_keys AS k
        ON l.order_id = k.order_id AND l.order_line_id = k.order_line_id
    LEFT JOIN subscription_transactions AS t
        ON l.order_line_id = t.order_line_id
    LEFT JOIN subscription_product_first_shipments AS h
        ON
            t.subscription_key = h.subscription_key
            AND t.product_key = h.product_key
    GROUP BY l.order_id, l.order_line_id, l.shipment_key
),

reorders AS (
    SELECT
        f.order_id AS reorder_order_id,
        f.order_line_id AS reorder_line_id,
        MIN(f.customer_id) AS reorder_customer_id,
        MIN(f.pet_id) AS reorder_pet_id,
        MIN(f.product_part_number) AS reorder_product_part_number,
        MIN(f.is_vet_diet_flag) AS reorder_is_vet_diet,
        MIN(f.line_auto_reorder_flag) AS line_auto_reorder_flag,
        MIN(f.subscription_group_key) AS subscription_group_key,
        MIN(f.subscription_key) AS subscription_key,
        MIN(f.order_key) AS order_key,
        MIN(f.product_key) AS product_key,
        MIN(f.one_time_shipped_flag) AS one_time_shipped_flag,
        MIN(f.auto_added_flag) AS auto_added_flag,
        MIN(f.order_line_pbfresh_subscription_flag)
            AS order_line_pbfresh_subscription_flag,
        MAX(f.transaction_records) AS transaction_records,
        MAX(f.transaction_variants) AS transaction_variants,
        MIN(f.transaction_shipped_utc) AS transaction_shipped_utc,
        MIN(f.product_first_shipped_utc) AS product_first_shipped_utc,
        GREATEST(
            MAX(f.line_flag_variants),
            COUNT(DISTINCT COALESCE(f.line_auto_reorder_flag::VARCHAR, 'NULL'))
        ) AS flag_variants,
        MIN(f.placed_at_utc) AS reorder_placed_utc,
        MIN(f.shipped_at_utc) AS reorder_shipped_utc,
        SUM(f.net_sales)::VARCHAR AS reorder_known_net_sales,
        COUNT_IF(f.net_sales IS NULL) AS missing_sales_records,
        GREATEST(
            MAX(f.vet_diet_variants),
            COUNT(DISTINCT COALESCE(f.is_vet_diet_flag::VARCHAR, 'NULL')),
            MAX(f.sales_variants),
            MAX(f.customer_variants),
            MAX(f.pet_variants),
            MAX(f.part_variants),
            MAX(f.placement_variants),
            COUNT(DISTINCT f.customer_id)
            + IFF(COUNT_IF(f.customer_id IS NULL) > 0, 1, 0),
            COUNT(DISTINCT f.pet_id)
            + IFF(COUNT_IF(f.pet_id IS NULL) > 0, 1, 0),
            COUNT(DISTINCT f.product_part_number)
            + IFF(COUNT_IF(f.product_part_number IS NULL) > 0, 1, 0),
            COUNT(DISTINCT f.placed_at_utc)
            + IFF(COUNT_IF(f.placed_at_utc IS NULL) > 0, 1, 0)
        ) AS source_variants,
        MAX(o.order_has_cancellation) AS reorder_order_has_cancellation,
        MAX(o.order_has_unknown_status) AS reorder_order_has_unknown_status
    FROM financial AS f
    INNER JOIN order_cancellations AS o ON f.order_id = o.order_id
    GROUP BY f.order_id, f.order_line_id
    -- Require shipment on this physical line, never on another order line.
    HAVING MIN(f.shipped_at_utc) IS NOT NULL
)
,
aged_lines AS (
    SELECT
        original_order_id AS order_id,
        original_line_id AS order_line_id,
        original_customer_id AS customer_id,
        registry_variants
    FROM originals
),

cohort_customers AS (
    SELECT DISTINCT customer_id FROM aged_lines
),

first_upload_anchors AS (
    WITH vet_diet_order_keys AS (
    -- CUSTOMER_UPLOAD vet-diet history from every prescription source and date.
        SELECT
            l.customer_id,
            l.order_id,
            MAX(p.registry_variants) AS history_prescription_variants
        FROM edldb.bt_hca_hcdm.order_line_cost_measures_rxp AS l
        INNER JOIN cohort_customers AS c ON l.customer_id = c.customer_id
        INNER JOIN
            registry AS p
            ON
                NULLIF(TRIM(l.rx_id), '') = p.rx_id
                AND l.customer_id = p.customer_id
        WHERE
            l.is_vet_diet_flag = TRUE
            AND p.is_vet_diet_flag = TRUE
            AND p.approval_channel = 'CUSTOMER_UPLOAD'
        GROUP BY l.customer_id, l.order_id
    ),

    history_keys AS (
        SELECT DISTINCT order_id FROM vet_diet_order_keys
    ),

    history AS (
        SELECT
            o.order_id,
            MIN(o.customer_id) AS customer_id,
            MIN(o.order_placed_dttm) AS placed_at_utc,
            GREATEST(
                COUNT(DISTINCT o.customer_id)
                + IFF(COUNT_IF(o.customer_id IS NULL) > 0, 1, 0),
                COUNT(DISTINCT o.order_placed_dttm)
                + IFF(COUNT_IF(o.order_placed_dttm IS NULL) > 0, 1, 0),
                COUNT(DISTINCT o.order_first_order_placed_flag)
                + IFF(
                    COUNT_IF(o.order_first_order_placed_flag IS NULL) > 0, 1, 0
                )
            ) AS source_variants
        FROM edldb.ecom.orders AS o
        INNER JOIN history_keys AS k ON o.order_id = k.order_id
        GROUP BY o.order_id
    ),

    vet_history_audit AS (
        SELECT
            v.customer_id,
            COUNT(DISTINCT IFF(h.order_id IS NULL, v.order_id, NULL))
                AS vet_orders_missing_ecom_header,
            MAX(v.history_prescription_variants)
                AS history_prescription_variants
        FROM vet_diet_order_keys AS v
        LEFT JOIN
            history AS h
            ON v.order_id = h.order_id AND v.customer_id = h.customer_id
        GROUP BY v.customer_id
    ),

    ranked AS (
        SELECT
            *,
            MIN(placed_at_utc)
                OVER (PARTITION BY customer_id)
                AS earliest_placed_at_utc,
            ROW_NUMBER()
                OVER (
                    PARTITION BY customer_id
                    ORDER BY placed_at_utc NULLS LAST, order_id
                )
                AS first_rank
        FROM history
    ),

    first_orders AS (
        SELECT
            customer_id,
            COUNT_IF(placed_at_utc IS NULL) AS history_orders_missing_placement,
            MAX(source_variants) AS history_source_variants,
            MIN(earliest_placed_at_utc) AS first_placed_at_utc,
            COUNT_IF(placed_at_utc = earliest_placed_at_utc)
                AS earliest_timestamp_ties,
            MAX(IFF(first_rank = 1, order_id, NULL)) AS first_order_id
        FROM ranked
        GROUP BY customer_id
    ),

    selected_aged_keys AS (
    -- Only the first CUSTOMER_UPLOAD vet-diet aged order per customer is an
    -- anchor.
        SELECT DISTINCT
            a.order_id,
            a.order_line_id,
            GREATEST(
                a.registry_variants,
                f.history_source_variants,
                v.history_prescription_variants
            ) AS registry_variants
        FROM aged_lines AS a
        INNER JOIN
            first_orders AS f
            ON a.customer_id = f.customer_id AND a.order_id = f.first_order_id
        INNER JOIN vet_history_audit AS v ON a.customer_id = v.customer_id
        WHERE
            f.first_placed_at_utc IS NOT NULL AND f.earliest_timestamp_ties = 1
            AND f.history_orders_missing_placement = 0
            AND v.vet_orders_missing_ecom_header = 0
    )

    SELECT a.* REPLACE (k.registry_variants AS registry_variants)
    FROM originals AS a
    INNER JOIN selected_aged_keys AS k
        ON
            a.original_order_id = k.order_id
            AND a.original_line_id = k.order_line_id
),

first_vet_diet_anchors AS (
    WITH vet_diet_order_keys AS (
    -- Full vet-diet history; no CMPU, channel, RX-ID or date restriction here.
        SELECT DISTINCT
            l.customer_id,
            l.order_id
        FROM edldb.bt_hca_hcdm.order_line_cost_measures_rxp AS l
        INNER JOIN cohort_customers AS c ON l.customer_id = c.customer_id
        WHERE l.is_vet_diet_flag = TRUE
    ),

    history_keys AS (
        SELECT DISTINCT order_id FROM vet_diet_order_keys
    ),

    history AS (
        SELECT
            o.order_id,
            MIN(o.customer_id) AS customer_id,
            MIN(o.order_placed_dttm) AS placed_at_utc,
            GREATEST(
                COUNT(DISTINCT o.customer_id)
                + IFF(COUNT_IF(o.customer_id IS NULL) > 0, 1, 0),
                COUNT(DISTINCT o.order_placed_dttm)
                + IFF(COUNT_IF(o.order_placed_dttm IS NULL) > 0, 1, 0),
                COUNT(DISTINCT o.order_first_order_placed_flag)
                + IFF(
                    COUNT_IF(o.order_first_order_placed_flag IS NULL) > 0, 1, 0
                )
            ) AS source_variants
        FROM edldb.ecom.orders AS o
        INNER JOIN history_keys AS k ON o.order_id = k.order_id
        GROUP BY o.order_id
    ),

    vet_history_audit AS (
        SELECT
            v.customer_id,
            COUNT(DISTINCT IFF(h.order_id IS NULL, v.order_id, NULL))
                AS vet_orders_missing_ecom_header
        FROM vet_diet_order_keys AS v
        LEFT JOIN
            history AS h
            ON v.order_id = h.order_id AND v.customer_id = h.customer_id
        GROUP BY v.customer_id
    ),

    ranked AS (
        SELECT
            *,
            MIN(placed_at_utc)
                OVER (PARTITION BY customer_id)
                AS earliest_placed_at_utc,
            ROW_NUMBER()
                OVER (
                    PARTITION BY customer_id
                    ORDER BY placed_at_utc NULLS LAST, order_id
                )
                AS first_rank
        FROM history
    ),

    first_orders AS (
        SELECT
            customer_id,
            COUNT_IF(placed_at_utc IS NULL) AS history_orders_missing_placement,
            MAX(source_variants) AS history_source_variants,
            MIN(earliest_placed_at_utc) AS first_placed_at_utc,
            COUNT_IF(placed_at_utc = earliest_placed_at_utc)
                AS earliest_timestamp_ties,
            MAX(IFF(first_rank = 1, order_id, NULL)) AS first_order_id
        FROM ranked
        GROUP BY customer_id
    ),

    selected_aged_keys AS (
    -- Only the first vet-diet aged order per customer is an anchor.
        SELECT DISTINCT
            a.order_id,
            a.order_line_id,
            GREATEST(a.registry_variants, f.history_source_variants)
                AS registry_variants
        FROM aged_lines AS a
        INNER JOIN
            first_orders AS f
            ON a.customer_id = f.customer_id AND a.order_id = f.first_order_id
        INNER JOIN vet_history_audit AS v ON a.customer_id = v.customer_id
        WHERE
            f.first_placed_at_utc IS NOT NULL AND f.earliest_timestamp_ties = 1
            AND f.history_orders_missing_placement = 0
            AND v.vet_orders_missing_ecom_header = 0
    )

    SELECT a.* REPLACE (k.registry_variants AS registry_variants)
    FROM originals AS a
    INNER JOIN selected_aged_keys AS k
        ON
            a.original_order_id = k.order_id
            AND a.original_line_id = k.order_line_id
),

anchor_cohorts AS (
    SELECT
        'all-aged' AS cohort,
        a.*
    FROM originals AS a
    UNION ALL
    SELECT
        'first-upload' AS cohort,
        a.*
    FROM first_upload_anchors AS a
    UNION ALL
    SELECT
        'first-vet-diet' AS cohort,
        a.*
    FROM first_vet_diet_anchors AS a
),

anchors AS (
    SELECT
        a.*,
        t.subscription_group_key AS original_subscription_group_key,
        t.subscription_key AS original_subscription_key,
        t.order_key AS original_order_key,
        t.product_key AS original_product_key,
        t.one_time_shipped_flag AS original_one_time_shipped_flag,
        t.auto_added_flag AS original_auto_added_flag,
        t.order_line_pbfresh_subscription_flag
            AS original_order_line_pbfresh_subscription_flag,
        t.transaction_records AS original_transaction_records,
        t.transaction_variants AS original_transaction_variants,
        IFF(t.order_line_id IS NULL, FALSE, t.order_line_auto_reorder_flag)
            AS original_order_line_auto_reorder_flag
    FROM anchor_cohorts AS a
    LEFT JOIN subscription_transactions AS t
        ON a.original_line_id = t.order_line_id
),

cohorts AS (
    SELECT column1 AS cohort
    FROM
        VALUES
        ('all-aged'), ('first-upload'), ('first-vet-diet')
),

horizons AS (
    SELECT column1 AS days
    FROM
        VALUES
        (7), (14), (21), (28), (35), (42), (49), (56), (63), (70)
),

denominators AS (
    SELECT
        c.cohort,
        COUNT(DISTINCT a.original_customer_id) AS denominator
    FROM cohorts AS c LEFT JOIN anchors AS a ON c.cohort = a.cohort
    GROUP BY c.cohort
),

matched AS (
    -- Deduplicate physical lines across repeated anchors before counting money.
    SELECT DISTINCT
        r.*,
        a.cohort,
        h.days,
        -- Section 3.1.4: only autoship lines at the pair's earliest shipment.
        -- Missing pair keys/timestamps yield unknown, excluded eligibility.
        -- Missing transaction membership is already classified as FALSE.
        -- Financial shipment eligibility and placement windows still apply.
        r.transaction_shipped_utc = r.product_first_shipped_utc
        AND r.line_auto_reorder_flag = TRUE AS first_shipped_eligible
    FROM anchors AS a CROSS JOIN horizons AS h
    INNER JOIN reorders AS r
        ON
            a.original_customer_id = r.reorder_customer_id
            AND a.original_pet_id = r.reorder_pet_id
            AND a.original_product_part_number = r.reorder_product_part_number
            AND NULLIF(TRIM(a.original_product_part_number), '') IS NOT NULL
            AND a.original_order_id <> r.reorder_order_id
            AND a.original_cancel_utc < r.reorder_placed_utc
            AND r.reorder_placed_utc
            <= DATEADD(DAY, h.days, a.original_cancel_utc)
    WHERE
        DATEADD(DAY, h.days, a.original_cancel_utc)
        <= '{{ as_of_date }}'::TIMESTAMP_NTZ
        AND r.reorder_order_has_cancellation = 0
        AND r.reorder_order_has_unknown_status = 0
),

summary_kinds AS (
    SELECT column1 AS record_type
    FROM VALUES ('summary'), ('shipped_summary'), ('first_shipped_summary')
),

scoped_matches AS (
    SELECT
        m.*,
        k.record_type,
        CASE k.record_type
            WHEN 'first_shipped_summary' THEN m.first_shipped_eligible
            WHEN 'shipped_summary' THEN m.reorder_shipped_utc IS NOT NULL
            ELSE
                m.reorder_shipped_utc IS NOT NULL
                AND m.line_auto_reorder_flag = FALSE
        END AS eligible
    FROM matched AS m CROSS JOIN summary_kinds AS k
),

summary AS (
    SELECT
        k.record_type,
        d.cohort,
        h.days,
        d.denominator,
        COUNT(DISTINCT IFF(
            m.eligible,
            m.reorder_customer_id, NULL
        )) AS customers,
        100.0 * customers / NULLIF(d.denominator, 0) AS percentage,
        COUNT(DISTINCT IFF(
            m.eligible,
            m.reorder_order_id, NULL
        )) AS orders,
        COALESCE(COUNT_IF(m.eligible), 0) AS lines,
        COALESCE(SUM(IFF(
            m.eligible,
            m.reorder_known_net_sales::NUMBER(38, 5), NULL
        )), 0)::VARCHAR
            AS known_net_sales,
        COALESCE(SUM(IFF(
            m.eligible,
            m.missing_sales_records, 0
        )), 0) AS missing_sales_records,
        COALESCE(COUNT_IF(
            m.reorder_line_id IS NOT NULL AND m.eligible IS NULL
        ), 0) AS unknown_eligibility_lines,
        COUNT(DISTINCT m.reorder_customer_id) AS unfiltered_customers,
        COUNT(DISTINCT m.reorder_order_id) AS unfiltered_orders,
        COUNT(m.reorder_line_id) AS unfiltered_lines,
        COALESCE(COUNT_IF(
            m.reorder_line_id IS NOT NULL
            AND m.line_auto_reorder_flag IS NULL
            AND m.reorder_shipped_utc IS NOT NULL
        ), 0) AS null_flag_lines,
        COUNT(DISTINCT IFF(
            m.line_auto_reorder_flag IS NULL
            AND m.reorder_shipped_utc IS NOT NULL,
            m.reorder_order_id, NULL
        )) AS null_flag_orders,
        COUNT(DISTINCT IFF(
            m.line_auto_reorder_flag IS NULL
            AND m.reorder_shipped_utc IS NOT NULL,
            m.reorder_customer_id, NULL
        )) AS null_flag_customers
    FROM denominators AS d CROSS JOIN horizons AS h
    CROSS JOIN summary_kinds AS k
    LEFT JOIN scoped_matches AS m
        ON
            d.cohort = m.cohort AND h.days = m.days
            AND k.record_type = m.record_type
    GROUP BY k.record_type, d.cohort, h.days, d.denominator
)

SELECT
    s.record_type,
    TO_JSON(OBJECT_CONSTRUCT_KEEP_NULL(s.*)) AS payload
FROM summary AS s
UNION ALL
SELECT
    'anchor' AS record_type,
    TO_JSON(OBJECT_CONSTRUCT_KEEP_NULL(a.*)) AS payload
FROM anchors AS a
UNION ALL
SELECT
    'line' AS record_type,
    TO_JSON(OBJECT_CONSTRUCT_KEEP_NULL(r.*)) AS payload
FROM reorders AS r
UNION ALL
SELECT
    'shipment' AS record_type,
    TO_JSON(OBJECT_CONSTRUCT_KEEP_NULL(f.*)) AS payload
FROM financial AS f
UNION ALL
SELECT
    'matched' AS record_type,
    TO_JSON(OBJECT_CONSTRUCT_KEEP_NULL(m.*)) AS payload
FROM matched AS m

UNION ALL
SELECT
    'subscription_history' AS record_type,
    TO_JSON(OBJECT_CONSTRUCT_KEEP_NULL(h.*)) AS payload
FROM subscription_shipped_history AS h
